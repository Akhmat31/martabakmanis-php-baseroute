{
    "name": "mylib/simple-framework",
    "description": "A simple PHP micro-framework with routing capabilities using PSR standards",
    "type": "library",
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.8",
        "monolog/monolog": "^3.5",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "symfony/dotenv": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "MyLib\\": "martabakmanis/src/"
        }
    },
    "authors": [
        {
            "name": "Developer",
            "email": "dev@example.com"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
